","data":{"text/plain":"  Val:   0%|          | 0/33 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"b6161177579540c4a3413efa7a4e13df"}},"metadata":{}},{"name":"stdout","text":"  Train Loss: 0.4978 | Val Loss: 1.3236 | Val F1(cat): 0.8440\n  ✓ Val F1 improved: 0.8421 → 0.8440. Saving.\n\nEpoch 47/50\n  LR (head): 4.12e-04\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"  Train:   0%|          | 0/151 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"c0189873d8754657ac14473b49347806"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"  Val:   0%|          | 0/33 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"d1af799ea9064118a84606b0135e2716"}},"metadata":{}},{"name":"stdout","text":"  Train Loss: 0.4677 | Val Loss: 6.4728 | Val F1(cat): 0.8511\n  ✓ Val F1 improved: 0.8440 → 0.8511. Saving.\n\nEpoch 48/50\n  LR (head): 3.97e-04\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"  Train:   0%|          | 0/151 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"5029d46f2369459aba3ac7161674b7ec"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"  Val:   0%|          | 0/33 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"dc9c7ecaa7174717886f04dba0482a25"}},"metadata":{}},{"name":"stdout","text":"  Train Loss: 0.4992 | Val Loss: 0.9933 | Val F1(cat): 0.8247\n  ✗ No F1 improvement. (1/15)\n\nEpoch 49/50\n  LR (head): 3.81e-04\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"  Train:   0%|          | 0/151 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"ad904f2985b1469fadc6056dae6498f6"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"  Val:   0%|          | 0/33 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"dca436bea47d456194119c1a9709f595"}},"metadata":{}},{"name":"stdout","text":"  Train Loss: 0.4978 | Val Loss: 2.6655 | Val F1(cat): 0.8530\n  ✓ Val F1 improved: 0.8511 → 0.8530. Saving.\n\nEpoch 50/50\n  LR (head): 3.63e-04\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"  Train:   0%|          | 0/151 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"219b5104052442d3818258af429240ea"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"  Val:   0%|          | 0/33 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"b1ebf2db06da43ac8075c99cc3b6b231"}},"metadata":{}},{"name":"stdout","text":"  Train Loss: 0.4880 | Val Loss: 0.3088 | Val F1(cat): 0.8247\n  ✗ No F1 improvement. (1/15)\n\nBest Val F1: 0.8530 | Best Val Loss: 2.6655\nModel saved to /kaggle/working/best_cataract_model.pth\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1400x500 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":70},{"cell_type":"markdown","source":"## Phase 5: Meaningful Evaluation\nBecause of my extreme 93% negative class size, 'Accuracy' is a practically useless trap. I evaluate using **Precision, Recall, and F1-Score**.\n- I evaluate strictly on the unseen `test_loader` to measure real-world performance.\n- I manually apply `torch.sigmoid` to map the raw model logits between 0 and 1, explicitly triggering a visual prediction output at `> 0.5`.\n- I plot a Confusion Matrix to visually confirm how many True Cataracts I caught vs. how many healthy eyes I falsely predicted.","metadata":{"id":"mgFc_1xoPfIr"}},{"cell_type":"code","source":"\ndef find_optimal_threshold(model, val_loader, device):\n    \"\"\"Sweep thresholds on validation set to maximize F1.\"\"\"\n    model.eval()\n    all_probs, all_labels = [], []\n    with torch.no_grad():\n        for inputs, labels in tqdm(val_loader, desc=\"Threshold search\"):\n            inputs = inputs.to(device)\n            probs = torch.sigmoid(model(inputs))\n            all_probs.extend(probs.cpu().numpy().flatten())\n            all_labels.extend(labels.numpy().flatten())\n\n    best_f1, best_t = 0, 0.5\n    for t in np.arange(0.15, 0.85, 0.01):\n        preds = [1 if p > t else 0 for p in all_probs]\n        f1 = f1_score(all_labels, preds, pos_label=1)\n        if f1 > best_f1:\n            best_f1, best_t = f1, t\n\n    print(f\"\\nOptimal threshold: {best_t:.2f} (Val F1={best_f1:.4f})\")\n    return best_t\n\ndef tta_predict(model, inputs, device):\n    \"\"\"5-augmentation Test-Time Augmentation ensemble.\"\"\"\n    model.eval()\n    with torch.no_grad():\n        # 1. Original\n        p1 = torch.sigmoid(model(inputs))\n        # 2. Horizontal flip\n        p2 = torch.sigmoid(model(torch.flip(inputs, [3])))\n        # 3. Vertical flip\n        p3 = torch.sigmoid(model(torch.flip(inputs, [2])))\n        # 4. Both flips\n        p4 = torch.sigmoid(model(torch.flip(inputs, [2, 3])))\n        # 5. Slight rotation via grid sample (90 degrees)\n        rotated = torch.rot90(inputs, k=1, dims=[2, 3])\n        p5 = torch.sigmoid(model(rotated))\n    return (p1 + p2 + p3 + p4 + p5) / 5.0\n\ndef evaluate_model(model, test_loader, device, threshold):\n    \"\"\"Full evaluation with enhanced TTA and comprehensive metrics.\"\"\"\n    print(f\"\\nEvaluating on Test Set (threshold={threshold:.2f}, TTA=5x)...\")\n    model.eval()\n    all_probs, all_labels = [], []\n\n    with torch.no_grad():\n        for inputs, labels in tqdm(test_loader, desc=\"Testing (TTA)\"):\n            inputs = inputs.to(device)\n            probs = tta_predict(model, inputs, device)\n            all_probs.extend(probs.cpu().numpy().flatten())\n            all_labels.extend(labels.numpy().flatten())\n\n    all_labels = np.array(all_labels)\n    all_probs = np.array(all_probs)\n    all_preds = (all_probs > threshold).astype(int)\n\n    # Classification Report\n    print(\"\\n--- Classification Report ---\")\n    print(classification_report(all_labels, all_preds, target_names=['Normal (0)', 'Cataract (1)']))\n\n    # ROC-AUC\n    roc = roc_auc_score(all_labels, all_probs)\n    print(f\"ROC-AUC: {roc:.4f}\")\n\n    # Plots\n    fig, axes = plt.subplots(1, 3, figsize=(20, 5))\n\n    # Confusion Matrix\n    cm = confusion_matrix(all_labels, all_preds)\n    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',\n                xticklabels=['Normal', 'Cataract'],\n                yticklabels=['Normal', 'Cataract'], ax=axes[0])\n    axes[0].set_ylabel('True Label'); axes[0].set_xlabel('Predicted')\n    axes[0].set_title(f'Confusion Matrix (t={threshold:.2f})')\n\n    # PR Curve\n    precision, recall, _ = precision_recall_curve(all_labels, all_probs)\n    pr_auc = auc(recall, precision)\n    axes[1].plot(recall, precision, 'darkorange', lw=2, label=f'PR AUC={pr_auc:.3f}')\n    axes[1].set_xlabel('Recall'); axes[1].set_ylabel('Precision')\n    axes[1].set_title('Precision-Recall Curve'); axes[1].legend(); axes[1].grid(True)\n\n    # Threshold sweep visualization\n    thresholds = np.arange(0.1, 0.9, 0.01)\n    f1s = [f1_score(all_labels, (all_probs > t).astype(int), pos_label=1, zero_division=0) for t in thresholds]\n    axes[2].plot(thresholds, f1s, 'green', lw=2)\n    axes[2].axvline(x=threshold, color='red', linestyle='--', label=f'Chosen={threshold:.2f}')\n    axes[2].set_xlabel('Threshold'); axes[2].set_ylabel('F1 Score')\n    axes[2].set_title('F1 vs Threshold'); axes[2].legend(); axes[2].grid(True)\n\n    plt.tight_layout(); plt.show()\n    return all_probs, all_labels\n","metadata":{"execution":{"iopub.status.busy":"2026-05-09T19:58:30.372375Z","iopub.execute_input":"2026-05-09T19:58:30.372782Z","iopub.status.idle":"2026-05-09T19:58:30.387738Z","shell.execute_reply.started":"2026-05-09T19:58:30.372748Z","shell.execute_reply":"2026-05-09T19:58:30.386918Z"},"id":"7MiNPVdLPh2a","trusted":true},"outputs":[],"execution_count":71},{"cell_type":"code","source":"# ========================================\n# Execute Phase 5\n# ========================================\n# I trigger evaluation logic using the newly trained architecture with TTA and a safer Triage Threshold\noptimal_threshold = find_optimal_threshold(trained_model, val_loader, device)\nall_probs, all_labels = evaluate_model(trained_model, test_loader, device, optimal_threshold)","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":779,"referenced_widgets":["3635c295ac494826923fe9294cec655c","5a8b2e384643465987c9f3369f2e43a9","5bee809ee63e48cbb65ecbbb9bf4b379","a022f59d06b0424ea130ce8f475c8a28","087f9fe3674b40359f5eacdf5775ad01","2923eab7cb0942029be7de7b50a1b630","5280436ef3224feb823ad275ff419031","d3e6c4b0975f4d34a363728560e4c1ad","c0e9097c28ef4e05b9bc19c1240f7616","57d66f0e3703407996ef03920d7c07da","d6b582fd2b6c4455a951b305bd9df572"]},"execution":{"iopub.status.busy":"2026-05-09T19:58:30.388670Z","iopub.execute_input":"2026-05-09T19:58:30.388944Z","iopub.status.idle":"2026-05-09T20:00:01.528107Z","shell.execute_reply.started":"2026-05-09T19:58:30.388912Z","shell.execute_reply":"2026-05-09T20:00:01.527415Z"},"id":"ONGV-2tNPlPV","outputId":"bcdb7702-ee1a-491c-97a3-75afa6c20c18","trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"Threshold search:   0%|          | 0/33 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"33309e2cf775482da671a744e5978fd0"}},"metadata":{}},{"name":"stdout","text":"\nOptimal threshold: 0.74 (Val F1=0.8914)\n\nEvaluating on Test Set (threshold=0.74, TTA=5x)...\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Testing (TTA):   0%|          | 0/1034 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"bd183e6cc7e045eca6a7e2c190119d29"}},"metadata":{}},{"name":"stdout","text":"\n--- Classification Report ---\n              precision    recall  f1-score   support\n\n  Normal (0)       0.97      0.99      0.98       899\nCataract (1)       0.89      0.81      0.85       135\n\n    accuracy                           0.96      1034\n   macro avg       0.93      0.90      0.91      1034\nweighted avg       0.96      0.96      0.96      1034\n\nROC-AUC: 0.9450\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 2000x500 with 4 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":72},{"cell_type":"markdown","source":"## Phase 6: Model Explainability (Grad-CAM)\nBecause this is a medical triage tool, achieving high metrics is not enough. We must have a **defensible methodology** (as outlined in the proposal). \nWe use Gradient-weighted Class Activation Mapping (Grad-CAM) targeting the deepest convolutional layer of our ResNet50 (`layer4`).\nThis visualizes a heatmap over the original image, mathematically proving that the model is diagnosing a Cataract by looking at the opacity of the lens, rather than cheating by looking at hospital watermarks, text, or border artifacts.","metadata":{}},{"cell_type":"code","source":"!pip install grad-cam\n\nfrom pytorch_grad_cam import GradCAM\nfrom pytorch_grad_cam.utils.image import show_cam_on_image\n\ndef generate_gradcam(model, test_loader, device, num_images=4):\n    print(\"\\nGenerating Grad-CAM on EfficientNet-B3 final features...\")\n    # Target the last features block\n    target_layers = [model.features[-1]]\n    model.eval()\n    for p in model.parameters():\n        p.requires_grad = True\n\n    cam = GradCAM(model=model, target_layers=target_layers)\n    shown = 0\n    fig, axes = plt.subplots(num_images, 2, figsize=(10, 4*num_images))\n\n    for inputs, labels in test_loader:\n        if shown >= num_images:\n            break\n        if int(labels[0].item()) == 0:\n            continue\n        inputs = inputs.to(device)\n        output = model(inputs)\n        prob = torch.sigmoid(output).item()\n        pred = 1 if prob > 0.5 else 0\n        grayscale_cam = cam(input_tensor=inputs, targets=None)[0, :]\n        img_np = inputs[0].cpu().numpy().transpose((1,2,0))\n        img_np = np.clip(np.array([0.229,0.224,0.225]) * img_np + np.array([0.485,0.456,0.406]), 0, 1)\n        cam_image = show_cam_on_image(img_np, grayscale_cam, use_rgb=True)\n        axes[shown,0].imshow(img_np); axes[shown,0].set_title(\"Original (Cataract)\"); axes[shown,0].axis('off')\n        color = \"green\" if pred == 1 else \"red\"\n        pred_text = \"Cataract\" if pred == 1 else \"Normal\"\n        axes[shown,1].imshow(cam_image)\n        axes[shown,1].set_title(f\"Grad-CAM ({pred_text} {prob*100:.1f}%)\", color=color)\n        axes[shown,1].axis('off')\n        shown += 1\n\n    plt.tight_layout(); plt.show()\n\n\n# Execute Phase 6\n# Uses the trained_model strictly located on CPU or GPU device\ngenerate_gradcam(trained_model, test_loader, device)","metadata":{"execution":{"iopub.status.busy":"2026-05-09T20:00:01.529459Z","iopub.execute_input":"2026-05-09T20:00:01.529790Z","iopub.status.idle":"2026-05-09T20:00:06.707012Z","shell.execute_reply.started":"2026-05-09T20:00:01.529764Z","shell.execute_reply":"2026-05-09T20:00:06.705935Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Requirement already satisfied: grad-cam in /usr/local/lib/python3.12/dist-packages (1.5.5)\nRequirement already satisfied: numpy in /usr/local/lib/python3.12/dist-packages (from grad-cam) (2.0.2)\nRequirement already satisfied: Pillow in /usr/local/lib/python3.12/dist-packages (from grad-cam) (11.3.0)\nRequirement already satisfied: torch>=1.7.1 in /usr/local/lib/python3.12/dist-packages (from grad-cam) (2.10.0+cu128)\nRequirement already satisfied: torchvisi