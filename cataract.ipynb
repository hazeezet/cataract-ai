sed_images/` directory before keeping the row.\nThen I split the dataset into Train (70%), Valid (15%), and Test (15%) using stratified splitting.","metadata":{"id":"DAiJUXAodYo-"}},{"cell_type":"code","source":"# USING GOOGLE COLAB\n# from google.colab import drive\n# drive.mount(\"/content/drive\", force_remount=True)\n# !ls \"/content/drive/MyDrive/Colab_Contents/cataract\"\n\n# USING KAGGLE NOTEBOOK\nbase_path = \"/kaggle/input/datasets/hazeezet/cataract\"\nprint(os.listdir(base_path))","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"execution":{"iopub.status.busy":"2026-05-21T13:03:17.771065Z","iopub.execute_input":"2026-05-21T13:03:17.771351Z","iopub.status.idle":"2026-05-21T13:03:17.788590Z","shell.execute_reply.started":"2026-05-21T13:03:17.771330Z","shell.execute_reply":"2026-05-21T13:03:17.787795Z"},"id":"UFPwca2nhteU","outputId":"0676d1c9-4d74-4f44-8845-e9159ca44508","trusted":true},"outputs":[{"name":"stdout","text":"['preprocessed_images', 'additional_cataract_images', 'full_df.csv']\n","output_type":"stream"}],"execution_count":17},{"cell_type":"code","source":"# USING GOOGLE COLAB\n# !ln -s \"/content/drive/MyDrive/Colab_Contents/cataract\" \"/content/cataract\"\n\n# USING KAGGLE NOTEBOOK\n!ln -s \"/kaggle/input/datasets/hazeezet/cataract\" \"/content/cataract\"","metadata":{"execution":{"iopub.status.busy":"2026-05-21T13:03:17.789595Z","iopub.execute_input":"2026-05-21T13:03:17.789884Z","iopub.status.idle":"2026-05-21T13:03:17.950745Z","shell.execute_reply.started":"2026-05-21T13:03:17.789852Z","shell.execute_reply":"2026-05-21T13:03:17.949876Z"},"id":"EAK3QxcAp-UU","trusted":true},"outputs":[{"name":"stdout","text":"ln: failed to create symbolic link '/content/cataract/cataract': Read-only file system\n","output_type":"stream"}],"execution_count":18},{"cell_type":"code","source":"\ndef set_seed(seed=42):\n    \"\"\"\n    Sets all random seeds to ensure the model's weight initialization, \n    data augmentations, and training splits are fully reproducible (persistent) across runs.\n    \"\"\"\n    random.seed(seed)\n    os.environ['PYTHONHASHSEED'] = str(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    torch.cuda.manual_seed(seed)\n    torch.cuda.manual_seed_all(seed)\n    # Force deterministic behavior for CuDNN\n    torch.backends.cudnn.deterministic = True\n    torch.backends.cudnn.benchmark = False\n    print(f\"Global seed set to: {seed} for strict reproducibility.\")\n\nset_seed(42)","metadata":{"execution":{"iopub.status.busy":"2026-05-21T13:03:17.952741Z","iopub.execute_input":"2026-05-21T13:03:17.953004Z","iopub.status.idle":"2026-05-21T13:03:17.961131Z","shell.execute_reply.started":"2026-05-21T13:03:17.952976Z","shell.execute_reply":"2026-05-21T13:03:17.960474Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Global seed set to: 42 for strict reproducibility.\n","output_type":"stream"}],"execution_count":19},{"cell_type":"code","source":"csv_filepath = '/content/cataract/full_df.csv'\nimage_directory = '/content/cataract/preprocessed_images'","metadata":{"execution":{"iopub.status.busy":"2026-05-21T13:03:17.962198Z","iopub.execute_input":"2026-05-21T13:03:17.962502Z","iopub.status.idle":"2026-05-21T13:03:17.979225Z","shell.execute_reply.started":"2026-05-21T13:03:17.962478Z","shell.execute_reply":"2026-05-21T13:03:17.978352Z"},"trusted":true},"outputs":[],"execution_count":20},{"cell_type":"code","source":"def load_and_clean_data(csv_path: str, image_dir: str) -> pd.DataFrame:\n    \"\"\"\n    Loads the label dataframe and filters out filenames that don't physically exist in the image directory.\n    \"\"\"\n    print(f\"Loading dataframe from {csv_path}...\")\n    full_df = pd.read_csv(csv_path)\n\n    data = full_df[['filename', 'C']].copy()\n    initial_count = len(data)\n\n    print(\"Verifying image existence...\")\n    data['file_exists'] = data['filename'].apply(lambda name: os.path.exists(os.path.join(image_dir, str(name))))\n\n    clean_data = data[data['file_exists'] == True].copy()\n    final_count = len(clean_data)\n\n    print(f\"Initial: {initial_count} | Valid: {len(clean_data)} | Cataract(C=1): {clean_data['C'].sum()}\")\n    return clean_data.drop(columns=['file_exists'])\n\n\ndef split_dataset_stratified(clean_metadata: pd.DataFrame):\n    \"\"\"\n    Splits the valid dataset into Train (70%), Validation (15%), and Test (15%).\n    Uses stratification on the 'C' column to keep the extreme minority class (Cataract)\n    proportionally balanced across all splits.\n    \"\"\"\n    print(\"\\nSplitting dataset into [Train 70% | Val 15% | Test 15%]...\")\n    train_df, temp_df = train_test_split(\n        clean_metadata,\n        test_size=0.30,\n        stratify=clean_metadata['C'],\n        random_state=42\n    )\n\n    val_df, test_df = train_test_split(\n        temp_df,\n        test_size=0.50,\n        stratify=temp_df['C'],\n        random_state=42\n    )\n\n    for name, split in [(\"Train\", train_df), (\"Val\", val_df), (\"Test\", test_df)]:\n        print(f\"  {name}: {len(split)} samples, Cataract: {split['C'].sum()} ({split['C'].mean()*100:.1f}%)\")\n    return train_df, val_df, test_df\n\n\n\nclean_df = load_and_clean_data(csv_filepath, image_directory)\n\nnew_images_dir = '/content/cataract/additional_cataract_images'\nnew_image_paths = glob.glob(f\"{new_images_dir}/*.*\")\nif new_image_paths:\n    new_df = pd.DataFrame({'filename': new_image_paths, 'C': 1})\n    clean_df = pd.concat([clean_df, new_df], ignore_index=True)\n    print(f\"Added {len(new_image_paths)} additional cataract images.\")\n\nprint(f\"\\nDataset: Normal={len(clean_df[clean_df['C']==0])}, Cataract={len(clean_df[clean_df['C']==1])}\")\ntrain_df, val_df, test_df = split_dataset_stratified(clean_df)","metadata":{"execution":{"iopub.status.busy":"2026-05-21T13:03:17.980257Z","iopub.execute_input":"2026-05-21T13:03:17.980563Z","iopub.status.idle":"2026-05-21T13:03:27.280252Z","shell.execute_reply.started":"2026-05-21T13:03:17.980530Z","shell.execute_reply":"2026-05-21T13:03:27.279490Z"},"id":"9jY2qtSq6cQN","trusted":true},"outputs":[{"name":"stdout","text":"Loading dataframe from /content/cataract/full_df.csv...\nVerifying image existence...\nInitial: 6392 | Valid: 6392 | Cataract(C=1): 402\nAdded 4390 additional cataract images.\n\nDataset: Normal=5990, Cataract=4792\n\nSplitting dataset into [Train 70% | Val 15% | Test 15%]...\n  Train: 7547 samples, Cataract: 3354 (44.4%)\n  Val: 1617 samples, Cataract: 719 (44.5%)\n  Test: 1618 samples, Cataract: 719 (44.4%)\n","output_type":"stream"}],"execution_count":21},{"cell_type":"markdown","source":"## Phase 2: PyTorch Datasets & DataLoaders\nHere I create a custom PyTorch `Dataset` to load images on the fly using `PIL`.\n- I use `torchvision.transforms` with standard medical data augmentations (removing extreme destructive augmentations like RandomErasing since data starvation is solved).\n- I wrap the datasets in `DataLoader` instances to feed the GPU in optimized batches, utilizing standard shuffling for the rich 4K dataset.\n- I enable CLAHE preprocessing to dynamically normalize retinal contrast on the fly.","metadata":{"id":"4zwuQWbN7HO_"}},{"cell_type":"code","source":"IMG_SIZE = 456  # EfficientNet-B5 native resolution\nBATCH_SIZE = 8   # Reduced radically to prevent CUDA OOM\nACCUMULATION_STEPS = 4 # Simulates an effective batch size of 32 (8 * 4)\n\nclass CataractDataset(Dataset):\n    def __init__(self, dataframe, image_dir, transform=None, apply_clahe=False):\n        \"\"\"\n        Custom PyTorch Dataset for loading Cataract images dynamically.\n        Optionally applies OpenCV CLAHE preprocessing.\n        \"\"\"\n        self.dataframe = dataframe.reset_index(drop=True)\n        self.image_dir = image_dir\n        self.transform = transform\n        self.apply_clahe = apply_clahe\n\n    def __len__(self):\n        return len(self.dataframe)\n\n    def _apply_clahe(self, image_np):\n        # Convert RGB to LAB, apply CLAHE to L-channel, convert back to RGB\n        lab = cv2.cvtColor(image_np, cv2.COLOR_RGB2LAB)\n        l_channel, a, b = cv2.split(lab)\n        clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8,8))\n        cl = clahe.apply(l_channel)\n        limg = cv2.merge((cl, a, b))\n        return cv2.cvtColor(limg, cv2.COLOR_LAB2RGB)\n\n    def __getitem__(self, idx):\n        img_name = str(self.dataframe.loc[idx, 'filename'])\n        img_path = os.path.join(self.image_dir, img_name)\n\n        # Load image (convert to RGB safely)\n        image = Image.open(img_path).convert('RGB')\n        \n        # Apply CLAHE preprocessing if toggled\n        if self.apply_clahe:\n            image_np = np.array(image)\n            image_np = self._apply_clahe(image_np)\n            image = Image.fromarray(image_np)\n\n        # Label (Cataract = 1, Normal = 0)\n        label = self.dataframe.loc[idx, 'C']\n        \n        # Apply transforms uniformly depending on if we are in Train (self.transform)\n        if self.transform:\n            image = self.transform(image)\n\n        # The label shape needs to be (1,) for CrossEntropy BCE calculations\n        label = torch.tensor([label], dtype=torch.float32)\n\n        return image, label","metadata":{"execution":{"iopub.status.busy":"2026-05-21T13:03:27.281145Z","iopub.execute_input":"2026-05-21T13:03:27.281583Z","iopub.status.idle":"2026-05-21T13:03:27.289993Z","shell.execute_reply.started":"2026-05-21T13:03:27.281555Z","shell.execute_reply":"2026-05-21T13:03:27.289093Z"},"id":"cyhVU9v31sK1","trusted":true},"outputs":[],"execution_count":22},{"cell_type":"code","source":"# ========================================\n# Execute Phase 2\n# ========================================\n# ImageNet normalization\nNORMALIZE = transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n\n# v4: Refined medical augmentation (removed RandomErasing & extreme distortion)\ntrain_transform = transforms.Compose([\n    transforms.RandomResizedCrop(IMG_SIZE, scale=(0.8, 1.0), ratio=(0.9, 1.1)),\n    transforms.RandomHorizontalFlip(),\n    transforms.RandomVerticalFlip(),\n    transforms.RandomRotation(15),\n    transforms.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.1, hue=0.02),\n    transforms.RandomAffine(degrees=0, translate=(0.05, 0.05), shear=5),\n    transforms.GaussianBlur(kernel_size=3, sigma=(0.1, 1.0)),\n    transforms.ToTensor(),\n    NORMALIZE,\n])\n\nval_test_transform = transforms.Compose([\n    transforms.Resize(IMG_SIZE + 32),\n    transforms.CenterCrop(IMG_SIZE),\n    transforms.ToTensor(),\n    NORMALIZE,\n])\n\n# Enable CLAHE to highlight eye details; removed WeightedRandomSampler for natural rich data flow\ntrain_dataset = CataractDataset(train_df, image_directory, transform=train_transform, apply_clahe=True)\nval_dataset = CataractDataset(val_df, image_directory, transform=val_test_transform, apply_clahe=True)\ntest_dataset = CataractDataset(test_df, image_directory, transform=val_test_transform, apply_clahe=True)\n\ntrain_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True, num_workers=0, pin_memory=True)\nval_loader = DataLoader(val_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=0, pin_memory=True)\ntest_loader = DataLoader(test_dataset, batch_size=1, shuffle=False, num_workers=0, pin_memory=True)\n\nprint(f\"DataLoaders ready. Train batches: {len(train_loader)}\")","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"execution":{"iopub.status.busy":"2026-05-21T13:03:27.290859Z","iopub.execute_input":"2026-05-21T13:03:27.291476Z","iopub.status.idle":"2026-05-21T13:03:27.315317Z","shell.execute_reply.started":"2026-05-21T13:03:27.291450Z","shell.execute_reply":"2026-05-21T13:03:27.314691Z"},"id":"yeB2SG3p6vrE","outputId":"684757d1-5d9c-429a-a3f0-c8ad508e1e48","trusted":true},"outputs":[{"name":"stdout","text":"DataLoaders ready. Train batches: 944\n","output_type":"stream"}],"execution_count":23},{"cell_type":"markdown","source":"## Phase 3: Model Architecture (Transfer Learning)\nI leverage a pre-trained **EfficientNet-B5** model, which brings spectacular detail extraction capabilities for medical imagery.\n- Because we injected 4,000+ actual Cataract images, we no longer need to freeze the early layers. We unfreeze the **entire model** right from Epoch 1 so all convolutional layers can specifically learn eye textures instead of general ImageNet shapes.\n- I replace the final fully-connected classifier with a custom `Dropout` and `Linear` layer for evaluating my 1-dimensional output (Cataract vs Normal). Dropout is reduced to `0.3` because the richer dataset naturally combats overfitting.","metadata":{"id":"RMjKKQkl7TlP"}},{"cell_type":"code","source":"def build_cataract_model():\n    print(\"\\nLoading EfficientNet-B5 pretrained weights...\")\n    model = models.efficientnet_b5(weights=EfficientNet_B5_Weights.IMAGENET1K_V1)\n\n    # Unfreeze all features for full-depth fine-tuning on the massive 4K dataset\n    for param in model.parameters():\n        param.requires_grad = True\n\n    # Deep classification head (Lowered dropout slightly due to reduced risk of overfitting)\n    num_ftrs = model.classifier[1].in_features\n    model.classifier = nn.Sequential(\n        nn.Dropout(0.3),\n        nn.Linear(num_ftrs, 512),\n        nn.BatchNorm1d(512),\n        nn.ReLU(inplace=True),\n        nn.Dropout(0.2),\n        nn.Linear(512, 1)\n    )\n    print(f\"Custom head: {num_ftrs} → 512 → 1\")\n\n    return model","metadata":{"execution":{"iopub.status.busy":"2026-05-21T13:03:27.317536Z","iopub.execute_input":"2026-05-21T13:03:27.318311Z","iopub.status.idle":"2026-05-21T13:03:27.336260Z","shell.execute_reply.started":"2026-05-21T13:03:27.318286Z","shell.execute_reply":"2026-05-21T13:03:27.335689Z"},"id":"vZYl8PIg7YLx","trusted":true},"outputs":[],"execution_count":24},{"cell_type":"code","source":"# ========================================\n# Execute Phase 3\n# ========================================\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(f\"Assigning execution to Device: {device}\")\n\nset_seed(42)\n\nmodel = build_cataract_model()\nmodel = model.to(device)\n\nprint(\"\\nModel instantiated successfully on target device!\")\n","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"execution":{"iopub.status.busy":"2026-05-21T13:03:27.337147Z","iopub.execute_input":"2026-05-21T13:03:27.337485Z","iopub.status.idle":"2026-05-21T13:03:28.020075Z","shell.execute_reply.started":"2026-05-21T13:03:27.337453Z","shell.execute_reply":"2026-05-21T13:03:28.019188Z"},"id":"l6LiQerU7a_U","outputId":"d8572f98-6959-4197-87ea-167a3a113812","trusted":true},"outputs":[{"name":"stdout","text":"Assigning execution to Device: cuda\nGlobal seed set to: 42 for strict reproducibility.\n\nLoading EfficientNet-B5 pretrained weights...\nCustom head: 2048 → 512 → 1\n\nModel instantiated successfully on target device!\n","output_type":"stream"}],"execution_count":25},{"cell_type":"markdown","source":"## Phase 4: Training & Optimization\nI establish the PyTorch training environment:\n- **Loss Function:** Standard `BCEWithLogitsLoss` without artificial `pos_weight` scaling, as our rich dataset provides natural balance.\n- **Optimizer/Scheduler:** `AdamW` Optimizer with a 2-tier differential learning rate (slower for the freshly unfrozen backbone, faster for the new classifier head), paired with `CosineAnnealingWarmRestarts`.\n- **Training Loop:** I explicitly structure the epochs to track both Train and Validation Loss, tracking progress via `tqdm`, and saving only the `best_cataract_model.pth` based on peak validation performance (acting as my checkpoint/early-stopping system).","metadata":{"id":"G-kGSTx89Eta"}},{"cell_type":"code","source":"# --- Mixup ---\ndef mixup_data(x, y, alpha=0.4):\n    if alpha > 0:\n        lam = np.random.beta(alpha, alpha)\n    else:\n        lam = 1.0\n    idx = torch.randperm(x.size(0)).to(x.device)\n    mixed_x = lam * x + (1 - lam) * x[idx]\n    mixed_y = lam * y + (1 - lam) * y[idx]\n    return mixed_x, mixed_y\n\n# --- Label Smoothing ---\ndef smooth_labels(labels, smoothing=0.1):\n    return labels * (1.0 - smoothing) + 0.5 * smoothing\n","metadata":{"execution":{"iopub.status.busy":"2026-05-21T13:03:28.021077Z","iopub.execute_input":"2026-05-21T13:03:28.021406Z","iopub.status.idle":"2026-05-21T13:03:28.026644Z","shell.execute_reply.started":"2026-05-21T13:03:28.021378Z","shell.execute_reply":"2026-05-21T13:03:28.025801Z"},"trusted":true},"outputs":[],"execution_count":26},{"cell_type":"code","source":"def train_model(model, dataloaders, criterion, optimizer, scheduler, device, num_epochs=10, patience=3):\n    \"\"\"\n    Rigorous PyTorch Training Loop tailored for early stopping and model checkpointing.\n    Tracks and returns loss history for curve visualization.\n    Implements Gradient Accumulation to support large models on limited VRAM.\n    \"\"\"\n    print(f\"\\nInitiating Training Session...\")\n    best_wts = copy.deepcopy(model.state_dict())\n    best_val_loss = float('inf')\n    best_val_f1 = 0.0\n    no_improve = 0\n    history = {'train_loss': [], 'val_loss': [], 'val_f1': [], 'lr': []}\n\n    scaler = torch.amp.GradScaler('cuda')  # Mixed precision\n\n    for epoch in range(num_epochs):\n        print(f\"\\nEpoch {epoch+1}/{num_epochs}\")\n        current_lr = optimizer.param_groups[-1]['lr']\n        history['lr'].append(current_lr)\n        print(f\"  LR (head): {current_lr:.2e}\")\n\n        # ---- TRAIN ----\n        model.train()\n        running_loss = 0.0\n        optimizer.zero_grad() # Set zero grad once at the start of the epoch\n\n        for i, (inputs, labels) in enumerate(tqdm(train_loader, desc=\"  Train\")):\n            inputs, labels = inputs.to(device), labels.to(device)\n\n            # Mixup augmentation (50% probability)\n            if random.random() < 0.5:\n                inputs, labels = mixup_data(inputs, labels, alpha=0.4)\n\n            # Label smoothing\n            labels = smooth_labels(labels, smoothing=0.1)\n\n            with torch.amp.autocast('cuda'):\n                outputs = model(inputs)\n                loss = criterion(outputs, labels)\n                # Scale loss by accumulation steps so the gradients remain mathematically identical\n                # to a larger batch pass\n                loss = loss / ACCUMULATION_STEPS \n\n            scaler.scale(loss).backward()\n\n            # Execute gradient step only after accumulating 'ACCUMULATION_STEPS' batches\n            if (i + 1) % ACCUMULATION_STEPS == 0 or (i + 1) == len(train_loader):\n                scaler.unscale_(optimizer)\n                torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n                scaler.step(optimizer)\n                scaler.update()\n                optimizer.zero_grad()\n\n            running_loss += loss.item() * inputs.size(0) * ACCUMULATION_STEPS # Undoing scale for reporting\n\n        train_loss = running_loss / len(train_loader.dataset)\n        history['train_loss'].append(train_loss)\n\n        # ---- VALIDATE ----\n        model.eval()\n        val_loss = 0.0\n        val_preds, val_labels_all = [], []\n        with torch.no_grad():\n            for inputs, labels in tqdm(val_loader, desc=\"  Val\"):\n                inputs, labels = inputs.to(device), labels.to(device)\n                \n                # Removed AMP autocast for Validation to prevent NaN loss calculations\n                outputs = model(inputs)\n                loss = criterion(outputs, labels)\n                \n                val_loss += loss.item() * inputs.size(0)\n                probs = torch.sigmoid(outputs)\n                val_preds.extend(probs.cpu().numpy().flatten())\n                val_labels_all.extend(labels.cpu().numpy().flatten())\n\n        val_loss /= len(val_loader.dataset)\n        history['val_loss'].append(val_loss)\n\n        # Compute val F1 at 0.5 threshold\n        val_preds_binary = [1 if p > 0.5 else 0 for p in val_preds]\n        val_f1 = f1_score(val_labels_all, val_preds_binary, pos_label=1, zero_division=0)\n        history['val_f1'].append(val_f1)\n\n        print(f\"  Train Loss: {train_loss:.4f} | Val Loss: {val_loss:.4f} | Val F1(cat): {val_f1:.4f}\")\n\n        # Step scheduler\n        scheduler.step()\n\n        # Checkpoint on best val F1 (not loss — F1 is what we actually care about)\n        if val_f1 > best_val_f1:\n            print(f\"  ✓ Val F1 improved: {best_val_f1:.4f} → {val_f1:.4f}. Saving.\")\n            best_val_f1 = val_f1\n            best_val_loss = val_loss\n            best_wts = copy.deepcopy(model.state_dict())\n            no_improve = 0\n        else:\n            no_improve += 1\n            print(f\"  ✗ No F1 improvement. ({no_improve}/{patience})\")\n\n        if no_improve >= patience:\n            print(f\"\\nEarly stopping at epoch {epoch+1}.\")\n            break\n\n    print(f\"\\nBest Val F1: {best_val_f1:.4f} | Best Val Loss: {best_val_loss:.4f}\")\n    model.load_state_dict(best_wts)\n    return model, history","metadata":{"execution":{"iopub.status.busy":"2026-05-21T13:03:28.027779Z","iopub.execute_input":"2026-05-21T13:03:28.028247Z","iopub.status.idle":"2026-05-21T13:03:28.047457Z","shell.execute_reply.started":"2026-05-21T13:03:28.028222Z","shell.execute_reply":"2026-05-21T13:03:28.046817Z"},"id":"LfgBcPRM9HZu","trusted":true},"outputs":[],"execution_count":27},{"cell_type":"code","source":"# ========================================\n# Execute Phase 4\n# ========================================\n\n# USING GOOGLE COLAB\n# save_path = '/content/cataract/best_cataract_model.pth'\n\n# USING KAGGLE NOTEBOOK\nsave_path = '/kaggle/working/best_cataract_model.pth'\n\n# --- Configure optimizer, scheduler, loss ---\n# With 4,000+ positive images balancing the dataset, no pos_weight class weighting is required.\ncriterion = nn.BCEWithLogitsLoss()\n\n# 2-tier differential learning rates for full-network fine-tuning\noptimizer = optim.AdamW([\n    {'params': model.features.parameters(), 'lr': 3e-5},     # Slower adaptation for backbone\n    {'params': model.classifier.parameters(), 'lr': 3e-4},   # Faster adaptation for head\n], weight_decay=1e-4)\n\n# Cosine annealing with warm restarts\nscheduler = optim.lr_scheduler.CosineAnnealingWarmRestarts(optimizer, T_0=5, T_mult=2)\n\ndataloaders_dict = {'train': train_loader, 'val': val_loader}\n\ntry:\n    # Execute training\n    trained_model, history = train_model(\n        model, dataloaders_dict, criterion, optimizer, scheduler, device,\n        num_epochs=50, patience=15\n    )\n\n    torch.save(trained_model.state_dict(), save_path)\n    print(f\"Model saved to {save_path}\")\n\n    # Plot loss & F1 curves\n    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))\n    ax1.plot(history['train_loss'], label='Train Loss')\n    ax1.plot(history['val_loss'], label='Val Loss')\n    ax1.set_title('Loss Curves'); ax1.legend(); ax1.grid(True)\n    ax2.plot(history['val_f1'], label='Val F1 (Cataract)', color='green')\n    ax2.set_title('Validation F1'); ax2.legend(); ax2.grid(True)\n    plt.tight_layout(); plt.show()\nexcept Exception as e:\n    print(f\"\\n[Handled Error] The training process encountered an interruption: {str(e)}\")\n    torch.save(model.state_dict(), save_path.replace('.pth', '_interrupted.pth'))\n    trained_model = model","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000,"referenced_widgets":["3fa3b7f3dda6406db35ac8c6d9397b16","99b3f34fe159446f8724e5481a82f501","49a48a880b8e40d48a54a61a05c09c01","e43efb96135d48aabf39caf785a59373","f53029594904475099aae35b846af8e3","91730301f6624fc984d18e1f7dc48c7b","43155c380b8840d7b3752debf0691230","9057a9d2ebc24bdebdaca587fe51d0ea","1012f608cf4b43a5976edb9c24b2b4c3","1bb3d0913da641feb4b45a62e1148dc2","4bcd737d99ed446faf6f1a5b6ba66dcb","5cc83551130c4173903185bb7523f7c8","9c89cb806ada4e9393b4cd949a30ba42","f32d983cabb8409a9a89b